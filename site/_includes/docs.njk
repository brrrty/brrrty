---
layout: base.njk
---
{%- macro doclinks(current) %}
<p class="nav-group">Documentation</p>
<ul>
  <li><a href="/docs/"{% if current == "/docs/" %} aria-current="page"{% endif %}>Overview</a></li>
  {%- for doc in collections.docs %}
  <li><a href="{{ doc.url }}"{% if doc.url == current %} aria-current="page"{% endif %}>{{ doc.data.title }}</a></li>
  {%- endfor %}
</ul>
<p class="nav-group">Project</p>
<ul>
  <li><a href="/changelog/"{% if current == "/changelog/" %} aria-current="page"{% endif %}>Changelog</a></li>
  <li><a href="{{ site.repo }}">Repository</a></li>
  <li><a href="{{ site.repo }}/issues">Issues</a></li>
</ul>
{%- endmacro %}
{%- set body = content | prose %}
{%- set headings = content | toc %}
<div class="docs">
  <nav class="sidebar" aria-label="Docs">
    {{ doclinks(page.url) }}
  </nav>
  <details class="docs-menu">
    <summary><span class="docs-menu-label">Docs</span> <span class="docs-menu-current">{{ title }}</span></summary>
    <nav aria-label="Docs, compact">{{ doclinks(page.url) }}</nav>
  </details>
  <article class="prose">
    {%- if source %}
    {{ body | safe }}
    <p class="source">Source: <a href="{{ site.repo }}/blob/main/{{ source }}">{{ source }}</a></p>
    {%- else %}
    <h1>{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead | safe }}</p>{% endif %}
    {{ body | safe }}
    {%- endif %}
    {%- for doc in collections.docs %}{% if doc.url == page.url %}
    {%- set prev = collections.docs[loop.index0 - 1] %}
    {%- set next = collections.docs[loop.index0 + 1] %}
    {%- if prev or next %}
    <nav class="pager" aria-label="Previous and next">
      {%- if prev %}<a class="prev" href="{{ prev.url }}" rel="prev"><span class="dir">Previous</span><span class="pager-title">{{ prev.data.title }}</span></a>{% endif %}
      {%- if next %}<a class="next" href="{{ next.url }}" rel="next"><span class="dir">Next</span><span class="pager-title">{{ next.data.title }}</span></a>{% endif %}
    </nav>
    {%- endif %}
    {%- endif %}{% endfor %}
  </article>
  {%- if headings | length > 1 %}
  <nav class="toc" aria-labelledby="toc-title">
    <p id="toc-title">On this page</p>
    <ul>
      {%- for h in headings %}
      <li class="toc-{{ h.level }}"><a href="#{{ h.id }}">{{ h.html | safe }}</a></li>
      {%- endfor %}
    </ul>
  </nav>
  {%- endif %}
</div>
