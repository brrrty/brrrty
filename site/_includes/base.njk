<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} - {{ site.name }}{% else %}{{ site.name }}, a fast static site generator in Rust{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="preload" href="/assets/fonts/host-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
{#- A theme picked with the toggle, set before first paint so the page never flashes. #}
<script>try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script>
<script src="/assets/site.js" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="masthead">
  <div class="masthead-inner">
    {#- Logo slot: to show a mark, add
        <img src="/assets/logo.svg" width="24" height="24" alt="">
        inside this link, before the text. .wordmark lays an image out already. #}
    <a class="wordmark" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>brrrty</a>
    <nav class="site-nav" aria-label="Site">
      <ul>
        <li><a href="/docs/"{% if page.url.startsWith("/docs/") %} aria-current="page"{% endif %}>Docs</a></li>
        <li><a href="/changelog/"{% if page.url == "/changelog/" %} aria-current="page"{% endif %}>Changelog</a></li>
        <li><a href="{{ site.repo }}">GitHub</a></li>
      </ul>
      <button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" hidden>
        <svg class="i-moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M16.5 12.3A7 7 0 0 1 7.7 3.5a7 7 0 1 0 8.8 8.8Z"/></svg>
        <svg class="i-sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.4"/><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="foot">
  <div class="foot-inner">
    <p class="foot-mark">brrrty</p>
    <p>MIT licensed. Third-party credits in <a href="{{ site.repo }}/blob/main/NOTICE">NOTICE</a>.</p>
    <p>Made by <a href="{{ site.author.url }}">{{ site.author.name }}</a>.</p>
  </div>
</footer>
</body>
</html>
