 escape entity\">\\n</span> <span class=\"token escape entity\">\\t</span>'</span></span><span class=\"token punctuation\">;</span>\n\n<span class=\"token directive\"><span class=\"token keyword\">foo</span> <span class=\"token string\">\"<span class=\"token variable\">$foo</span>\"</span></span><span class=\"token punctuation\">;</span>\n<span class=\"token directive\"><span class=\"token keyword\">foo</span> <span class=\"token string\">\"<span class=\"token variable\">${foo}</span>bar\"</span></span><span class=\"token punctuation\">;</span>\n<span class=\"token directive\"><span class=\"token keyword\">foo</span> <span class=\"token string\">\"<span class=\"token variable\">$arg_;</span>\"</span></span><span class=\"token punctuation\">;</span>\n\n<span class=\"token comment\"># not escaped</span>\n<span class=\"token directive\"><span class=\"token keyword\">foo</span> <span class=\"token string\">\"\\<span class=\"token variable\">$foo</span>\"</span></span><span class=\"token punctuation\">;</span>","grammar":"nginx"},{"from":"nginx/variable_feature.test","code":"foo $host;\nfoo $geoip_city_country_code3\nset $0 foo;\nset $_ foo;\nset $arg_? foo;\n\n# real example\n\nlog_format main      '$remote_addr - $remote_user [$time_local]  '\n  '\"$request\" $status $bytes_sent '\n  '\"$http_referer\" \"$http_user_agent\" '\n  '\"$gzip_ratio\"';\n\nlocation / {\n    ssi on;\n    set $inc $request_uri;\n    if (!-f $request_filename) {\n        rewrite ^ /index.html last;\n    }\n    if (!-f $document_root$inc.html) {\n        return 404;\n    }\n}","html":"<span class=\"token directive\"><span class=\"token keyword\">foo</span> <span class=\"token variable\">$host</span></span><span class=\"token punctuation\">;</span>\n<span class=\"token directive\"><span class=\"token keyword\">foo</span> <span class=\"token variable\">$geoip_city_country_code3</span>\nset <span class=\"token variable\">$0</span> foo</span><span class=\"token punctuation\">;</span>\n<span class=\"token directive\"><span class=\"token keyword\">set</span> <span class=\"token variable\">$_</span> foo</span><span class=\"token punctuation\">;</span>\n<span class=\"token directive\"><span class=\"token keyword\">set</span> <span class=\"token variable\">$arg_?</span> foo</span><span class=\"token punctuation\">;</span>\n\n<span class=\"token comment\"># real example</span>\n\n<span class=\"token directive\"><span class=\"token keyword\">log_format</span> main      <span class=\"token string\">'<span class=\"token variable\">$remote_addr</span> - <span class=\"token variable\">$remote_user</span> [<span class=\"token variable\">$time_local]</span>  '</span>\n  <span class=\"token string\">'\"<span class=\"token variable\">$request</span>\" <span class=\"token variable\">$status</span> <span class=\"token variable\">$bytes_sent</span> '</span>\n  <span class=\"token string\">'\"<span class=\"token variable\">$http_referer</span>\" \"<span class=\"token variable\">$http_user_agent</span>\" '</span>\n  <span class=\"token string\">'\"<span class=\"token variable\">$gzip_ratio</span>\"'</span></span><span class=\"token punctuation\">;</span>\n\n<span class=\"token directive\"><span class=\"token keyword\">location</span> /</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token directive\"><span class=\"token keyword\">ssi</span> <span class=\"token boolean\">on</span></span><span class=\"token punctuation\">;</span>\n    <span class=\"token directive\"><span class=\"token keyword\">set</span> <span class=\"token variable\">$inc</span> <span class=\"token variable\">$request_uri</span></span><span class=\"token punctuation\">;</span>\n    <span class=\"token directive\"><span class=\"token keyword\">if</span> (!-f <span class=\"token variable\">$request_filename</span>)</span> <span class=\"token punctuation\">{</span>\n        <span class=\"token directive\"><span class=\"token keyword\">rewrite</span> ^ /index.html last</span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n    <span class=\"token directive\"><span class=\"token keyword\">if</span> (!-f <span class=\"token variable\">$document_root</span><span class=\"token variable\">$inc</span>.html)</span> <span class=\"token punctuation\">{</span>\n        <span class=\"token directive\"><span class=\"token keyword\">return</span> <span class=\"token number\">404</span></span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>","grammar":"nginx"},{"from":"corpus.txt nginx 0","code":"# nginx config\nuser www-data;\nworker_processes auto;\nhttp {\n    include /etc/nginx/mime.types;\n    server {\n        listen 443 ssl http2;\n        server_name example.com www.example.com;\n        root /var/www/html;\n        location ~* \\.(js|css|png)$ { expires 30d; add_header Cache-Control \"public\"; }\n        location / { try_files $uri $uri/ /index.php?$query_string; }\n        if ($http_user_agent ~ \"bot\") { return 403; }\n        rewrite ^/old/(.*)$ /new/$1 permanent;\n    }\n}\n","html":"<span class=\"token comment\"># nginx config</span>\n<span class=\"token directive\"><span class=\"token keyword\">user</span> www-data</span><span class=\"token punctuation\">;</span>\n<span class=\"token directive\"><span class=\"token keyword\">worker_processes</span> auto</span><span class=\"token punctuation\">;</span>\n<span class=\"token directive\"><span class=\"token keyword\">http</span></span> <span class=\"token punctuation\">{</span>\n    <span class=\"token directive\"><span class=\"token keyword\">include</span> /etc/nginx/mime.types</span><span class=\"token punctuation\">;</span>\n    <span class=\"token directive\"><span class=\"token keyword\">server</span></span> <span class=\"token punctuation\">{</span>\n        <span class=\"token directive\"><span class=\"token keyword\">listen</span> <span class=\"token number\">443</span> ssl http2</span><span class=\"token punctuation\">;</span>\n        <span class=\"token directive\"><span class=\"token keyword\">server_name</span> example.com www.example.com</span><span class=\"token punctuation\">;</span>\n        <span class=\"token directive\"><span class=\"token keyword\">root</span> /var/www/html</span><span class=\"token punctuation\">;</span>\n        <span class=\"token directive\"><span class=\"token keyword\">location</span> ~* \\.(js|css|png)$</span> <span class=\"token punctuation\">{</span> <span class=\"token directive\"><span class=\"token keyword\">expires</span> <span class=\"token number\">30d</span></span><span class=\"token punctuation\">;</span> <span class=\"token directive\"><span class=\"token keyword\">add_header</span> Cache-Control <span class=\"token string\">\"public\"</span></span><span class=\"token punctuation\">;</span> <span class=\"token punctuation\">}</span>\n        <span class=\"token directive\"><span class=\"token keyword\">location</span> /</span> <span class=\"token punctuation\">{</span> <span class=\"token directive\"><span class=\"token keyword\">try_files</span> <span class=\"token variable\">$uri</span> <span class=\"token variable\">$uri</span>/ /index.php?<span class=\"token variable\">$query_string</span></span><span class=\"token punctuation\">;</span> <span class=\"token punctuation\">}</span>\n        <span class=\"token directive\"><span class=\"token keyword\">if</span> (<span class=\"token variable\">$http_user_agent</span> ~ <span class=\"token string\">\"bot\"</span>)</span> <span class=\"token punctuation\">{</span> <span class=\"token directive\"><span class=\"token keyword\">return</span> <span class=\"token number\">403</span></span><span class=\"token punctuation\">;</span> <span class=\"token punctuation\">}</span>\n        <span class=\"token directive\"><span class=\"token keyword\">rewrite</span> ^/old/(.*)$ /new/<span class=\"token variable\">$1</span> permanent</span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>\n","grammar":"nginx"}]}
