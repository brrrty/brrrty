<article class="card">
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <p class="meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time> in <a href="/categories/{{ post.data.category | slugify }}/">{{ post.data.category }}</a></p>
  <p>{{ post.data.description }}</p>
</article>
