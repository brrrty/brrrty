---
layout: layouts/base.njk
pagination:
  data: collections.posts
  size: 10
  reverse: true
  alias: posts
permalink: "/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<h1>{% if pagination.pageNumber == 0 %}Latest posts{% else %}Posts, page {{ pagination.pageNumber + 1 }}{% endif %}</h1>
{%- for post in posts %}
<article class="card">
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <p class="meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time> &middot; {{ post.templateContent | readingTime }} min read</p>
  <p>{{ post.templateContent | excerpt(180) }}</p>
</article>
{%- endfor %}
{% include "partials/pager.njk" %}
