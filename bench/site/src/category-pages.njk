---
layout: layouts/base.njk
pagination:
  data: collections.categoryPages
  size: 1
  alias: cp
permalink: "/categories/{{ cp.category | slugify }}/{% if cp.pageNumber > 1 %}page/{{ cp.pageNumber }}/{% endif %}"
eleventyComputed:
  title: "{{ cp.category }}"
---
<h1>{{ cp.category }}</h1>
<p>{{ cp.total }} posts, page {{ cp.pageNumber }} of {{ cp.totalPages }}.</p>
<ol class="archive">
{%- for post in cp.posts %}
  <li><a href="{{ post.url }}">{{ post.data.title | title }}</a> <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></li>
{%- endfor %}
</ol>
{%- if cp.totalPages > 1 %}
<nav class="pager" aria-label="Pages">
  {%- for n in range(1, cp.totalPages + 1) %}
  <a href="/categories/{{ cp.category | slugify }}/{% if n > 1 %}page/{{ n }}/{% endif %}"{% if n == cp.pageNumber %} aria-current="page"{% endif %}>{{ n }}</a>
  {%- endfor %}
</nav>
{%- endif %}
